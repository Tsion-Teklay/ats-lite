# Copy to server/.env and adjust. Never commit real secrets.
NODE_ENV=development
PORT=4000

# Local Mongo (Docker Compose provides mongodb://mongo:27017/ats-lite) or a MongoDB Atlas URI.
MONGO_URI=mongodb://127.0.0.1:27017/ats-lite

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=replace-me-access
REFRESH_TOKEN_SECRET=replace-me-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
REFRESH_TOKEN_TTL_MS=604800000

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173

# Where uploaded résumés are written, and the maximum accepted size in bytes.
UPLOAD_DIR=./uploads
MAX_RESUME_BYTES=5242880
